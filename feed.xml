---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{%- comment -%}
  Hand-written instead of jekyll-feed, which cannot leave out unlisted posts.
{%- endcomment %}
{%- assign listed_posts = site.posts | where_exp: "post", "post.unlisted != true" | where_exp: "post", "post.date <= site.time" %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{% if listed_posts.size > 0 %}{{ listed_posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <icon>{{ '/assets/logo.png' | absolute_url }}</icon>
  {%- for post in listed_posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- for key in post.authors %}
    <author><name>{{ site.data.authors[key].name | xml_escape }}</name>{% if site.data.authors[key].url %}<uri>{{ site.data.authors[key].url }}</uri>{% endif %}</author>
    {%- endfor %}
    <summary>{{ post.description | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
